package alex2;

import java.util.Scanner;

public class Ejercicio2_Clase14_10_27 {

	public static void main(String[] args) {
		
		int numero;
		int numeroPares=0;
		int numeroImpares=0;
			
		Scanner sc=new Scanner(System.in);
		
		System.out.println("Introduce cuantos numeros quieres generar");
		numero=sc.nextInt();
		
		sc.close();
		
		for (int i = 1; i <numero; i++) {
			if(numero%2==0)
				numeroPares++;
			else
				numeroImpares++;
			
			System.out.println(i);
		}
		System.out.println("Cantidad de numeros pares "+numeroPares);
		System.out.println("Cantidad de numeros impares "+numeroImpares);
	}
}